# =====================================================
# Signs AI - Environment Variables Template
# =====================================================
# ※ このファイルを .env にコピーして、実際の値を設定してください。
# ※ 機密情報（APIキー等）はこのファイルに絶対に記載しないでください。

# Supabase (Required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (Email Service)
RESEND_API_KEY=

# Anthropic (AI Analysis - for future use)
# ANTHROPIC_API_KEY=

# Sentry (Error Tracking)
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=

# Slack Webhook (Notification - Optional)
# SLACK_WEBHOOK_URL=
